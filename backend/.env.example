# EvalForge API environment. Copy to backend/.env for local runs.
# For production, set these in the Render dashboard (or let render.yaml prompt for them).
EVALFORGE_ENVIRONMENT=development
EVALFORGE_DATABASE_URL=sqlite+aiosqlite:///./evalforge.db
# Cloud Postgres requires TLS. Set false only for a local Postgres without TLS.
# EVALFORGE_DATABASE_SSL=true
EVALFORGE_CORS_ORIGINS=["http://localhost:3000"]
EVALFORGE_DEMO_MODE=false
EVALFORGE_WRITE_API_TOKEN=

# Qdrant Cloud in production; embedded local Qdrant when both are unset.
# EVALFORGE_QDRANT_URL=https://<cluster>.<region>.cloud.qdrant.io:6333
# EVALFORGE_QDRANT_API_KEY=
# EVALFORGE_QDRANT_COLLECTION=evalforge_reference_v1
EVALFORGE_REFERENCE_INDEX_ON_STARTUP=true

# Free-tier deployment protections. Keep off for local full-suite runs.
EVALFORGE_LIVE_RUN_PROTECTION=false
EVALFORGE_LIVE_RUN_MAX_QUERIES=10
EVALFORGE_LIVE_RUN_DAILY_CAP=20
EVALFORGE_LIVE_RUN_PER_IP_LIMIT=3
EVALFORGE_LIVE_RUN_RATE_WINDOW_SECONDS=3600
# EVALFORGE_LIVE_RUN_IP_HASH_SALT=

# Optional real judge provider. The deterministic mock needs no key.
# EVALFORGE_GROQ_API_KEY=
# EVALFORGE_GROQ_MODEL=llama-3.3-70b-versatile
# EVALFORGE_JUDGE_PROVIDER=groq
# EVALFORGE_JUDGE_MODEL=llama-3.3-70b-versatile

EVALFORGE_LOG_LEVEL=INFO

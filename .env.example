# Backend
EVALFORGE_ENVIRONMENT=development
EVALFORGE_DATABASE_URL=sqlite+aiosqlite:///./evalforge.db
EVALFORGE_CORS_ORIGINS=["http://localhost:3000"]
# Unset uses embedded Qdrant at backend/data/qdrant, requiring no extra service.
# EVALFORGE_QDRANT_URL=http://localhost:6333

# Optional. A non-empty value protects every write endpoint. Leave blank for
# local-only development; set a long random value for any shared deployment.
EVALFORGE_WRITE_API_TOKEN=

# Optional. Read-only synthetic mode; write endpoints return HTTP 403.
EVALFORGE_DEMO_MODE=false

# Optional LLM provider and judge credentials. Mock mode needs none of these.
# EVALFORGE_GROQ_API_KEY=
# EVALFORGE_GROQ_MODEL=llama-3.3-70b-versatile
# EVALFORGE_OLLAMA_BASE_URL=http://localhost:11434
# EVALFORGE_OLLAMA_MODEL=llama3.1
# EVALFORGE_JUDGE_PROVIDER=groq
# EVALFORGE_JUDGE_MODEL=llama-3.3-70b-versatile

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel production: set NEXT_PUBLIC_API_URL to the Render service origin, without /api/v1.
# Example: https://evalforge-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# How long the dashboard waits for a sleeping free-tier backend before opening the
# committed recorded demo. The Render cold start is often 30-60 seconds.
NEXT_PUBLIC_BACKEND_WAKE_TIMEOUT_MS=20000
